import tushare as ts
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# ================== 1. 解决中文显示 ==================
plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'PingFang SC']
plt.rcParams['axes.unicode_minus'] = False

# ================== 2. 配置参数 ==================
TOKEN = '你的token'   # 请替换成你的真实 Tushare token

# 交易成本参数
COMMISSION_RATE = 0.0003   # 佣金费率 0.03%（万三）
SLIPPAGE_RATE = 0.0001     # 滑点费率 0.01%（万一）

# 需要对比的股票
STOCKS = {
    '600519.SH': '贵州茅台',
    '000858.SZ': '五粮液',
    '300750.SZ': '宁德时代',
    '000002.SZ': '万科A',
    '601318.SH': '中国平安'
}

START_DATE = '20200101'
END_DATE   = '20260430'
SHORT_WIN = 5
LONG_WIN  = 20

# ================== 3. 初始化 Tushare ==================
ts.set_token(TOKEN)
pro = ts.pro_api()


# ================== c  o  p  y      ==================


# ================== 4. 策略回测函数（含滑点佣金） ==================
def dual_ma_strategy_with_cost(ts_code, start, end, short, long, 
                                commission_rate, slippage_rate):
    """
    返回 DataFrame 包含策略累计收益（扣除交易成本）
    """
    df = pro.daily(ts_code=ts_code, start_date=start, end_date=end)
    if df.empty:
        return None
    df = df.sort_values('trade_date').reset_index(drop=True)
    
    # 计算均线
    df['SMA_short'] = df['close'].rolling(short).mean()
    df['SMA_long']  = df['close'].rolling(long).mean()
    
    # 生成信号
    df['signal'] = 0
    df.loc[df['SMA_short'] > df['SMA_long'], 'signal'] = 1
    df.loc[df['SMA_short'] < df['SMA_long'], 'signal'] = -1
    
    # 信号变化（买卖点）
    df['position_change'] = df['signal'].diff()
    
    # 计算每日收益率（不含成本）
    df['returns'] = df['close'].pct_change()
    
    # ========== 关键修改：扣除交易成本 ==========
    # 初始化每日交易成本列
    df['daily_cost'] = 0.0
    
    # 买入信号（position_change == 2）：以收盘价买入，支付滑点+佣金
    buy_mask = (df['position_change'] == 2)
    df.loc[buy_mask, 'daily_cost'] = (
        df.loc[buy_mask, 'close'] * slippage_rate +           # 滑点
        df.loc[buy_mask, 'close'] * commission_rate          # 佣金
    )
    
    # 卖出信号（position_change == -2）：以收盘价卖出，只支付佣金（滑点双向已算在买入侧）
    sell_mask = (df['position_change'] == -2)
    df.loc[sell_mask, 'daily_cost'] = (
        df.loc[sell_mask, 'close'] * commission_rate          # 卖出佣金
    )
    
    # 计算成本比例（相对于当日收盘价的比例，用于调整收益率）
    df['cost_ratio'] = df['daily_cost'] / df['close']
    
    # 策略收益率 = 信号收益 - 成本比例
    # 注意：成本只在交易当天扣除一次，所以当天信号收益要减去成本比例
    df['strategy_returns_raw'] = df['signal'].shift(1) * df['returns']
    df['strategy_returns'] = df['strategy_returns_raw'] - df['cost_ratio']
    
    # 累计收益
    df['cumulative_strategy'] = (1 + df['strategy_returns']).fillna(1).cumprod()
    df['cumulative_buyhold'] = (1 + df['returns']).fillna(1).cumprod()
    
    # 记录交易次数（用于统计）
    df['is_trade'] = (df['position_change'].abs() == 2)
    
    return df

# ================== 5. 回测并收集结果 ==================
results = {}

print(f"交易成本参数：佣金 {COMMISSION_RATE:.4%}，滑点 {SLIPPAGE_RATE:.4%}\n")

for ts_code, name in STOCKS.items():
    print(f"正在处理: {name} ({ts_code})")
    df = dual_ma_strategy_with_cost(ts_code, START_DATE, END_DATE, 
                                     SHORT_WIN, LONG_WIN,
                                     COMMISSION_RATE, SLIPPAGE_RATE)
    if df is None:
        print(f"  警告: {name} 没有获取到数据，已跳过")
        continue
    
    # 计算风险指标
    strat_returns = df['strategy_returns'].dropna()
    if len(strat_returns) == 0:
        print(f"  警告: {name} 策略收益序列为空，跳过")
        continue
    
    # 总收益率
    total_return = df['cumulative_strategy'].iloc[-1] - 1
    # 年化收益率
    years = len(df) / 252
    annual_return = (1 + total_return) ** (1 / years) - 1 if years > 0 else 0
    
    # 夏普比率
    risk_free = 0.02
    excess = strat_returns.mean() * 252 - risk_free
    sharpe = excess / (strat_returns.std() * np.sqrt(252)) if strat_returns.std() != 0 else 0
    
    # 最大回撤
    cum = (1 + strat_returns).cumprod()
    rolling_max = cum.expanding().max()
    drawdown = (cum - rolling_max) / rolling_max
    max_drawdown = drawdown.min()
    
    # 胜率
    win_rate = (strat_returns[strat_returns != 0] > 0).mean() if (strat_returns != 0).any() else 0
    
    # 交易次数统计
    trade_count = df['is_trade'].sum()
    
    results[name] = {
        'code': ts_code,
        'total_return': total_return,
        'annual_return': annual_return,
        'sharpe': sharpe,
        'max_drawdown': max_drawdown,
        'win_rate': win_rate,
        'trade_count': trade_count,
        'trade_date': df['trade_date'],
        'cumulative_strategy': df['cumulative_strategy'],
        'cumulative_buyhold': df['cumulative_buyhold']
    }
    print(f"  完成: 年化收益 {annual_return:.2%}, 夏普 {sharpe:.2f}, 交易次数 {trade_count}")

# ================== 6. 打印汇总表格 ==================
print("\n" + "="*80)
print(f"策略绩效汇总 (含交易成本：佣金{COMMISSION_RATE:.4%} 滑点{SLIPPAGE_RATE:.4%})")
print("="*80)
summary_df = pd.DataFrame([{
    '股票': name,
    '年化收益': f"{d['annual_return']:.2%}",
    '夏普比率': f"{d['sharpe']:.2f}",
    '最大回撤': f"{d['max_drawdown']:.2%}",
    '胜率': f"{d['win_rate']:.2%}",
    '交易次数': d['trade_count']
} for name, d in results.items()])
print(summary_df.to_string(index=False))

# ================== 7. 绘制收益曲线对比图 ==================
plt.figure(figsize=(14, 8))
for name, d in results.items():
    plt.plot(d['trade_date'], d['cumulative_strategy'], label=f"{name} (策略)", lw=1.5)
plt.title(f'多股票双均线策略累计收益对比\n(佣金{COMMISSION_RATE:.4%} 滑点{SLIPPAGE_RATE:.4%})', fontsize=14)
plt.xlabel('日期')
plt.ylabel('累计净值')
plt.legend()
plt.grid(True, alpha=0.3)
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('multi_stock_with_cost.png')
plt.show()

print(f"\n对比图已保存: multi_stock_with_cost.png")

