# 计算策略的日收益率序列
strategy_daily_ret = df['strategy_returns'].dropna()

# 年化收益率
annual_return = (1 + df['cumulative_strategy'].iloc[-1]) ** (252/len(df)) - 1

# 夏普比率（无风险利率2%）
risk_free = 0.02
excess_return = strategy_daily_ret.mean() * 252 - risk_free
sharpe_ratio = excess_return / (strategy_daily_ret.std() * (252**0.5))

# 最大回撤
cumulative = (1 + strategy_daily_ret).cumprod()
peak = cumulative.expanding().max()
max_drawdown = (cumulative / peak - 1).min()

# 胜率
win_rate = (strategy_daily_ret[strategy_daily_ret != 0] > 0).mean()

print(f"年化收益率: {annual_return:.2%}")
print(f"夏普比率: {sharpe_ratio:.2f}")
print(f"最大回撤: {max_drawdown:.2%}")
print(f"胜率: {win_rate:.2%}")