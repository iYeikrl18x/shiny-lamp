    import tushare as tsn,
    import pandas as pdn,
    n,
    # 用你的 token（已确认有2000积分）n,
    pro = ts.pro_api('token')n,
    n,
    # 获取贵州茅台日线数据n,
    df = pro.daily(ts_code='600519.SH', start_date='20200101', end_date='20260430')n,
    n,
    # 按日期升序排列n,
    df = df.sort_values('trade_date').reset_index(drop=True)n,
    n,
    # 计算5日和20日均线n,
    df['SMA5'] = df['close'].rolling(5).mean()n,
    df['SMA20'] = df['close'].rolling(20).mean()n,
    n,
    # 生成信号：1=买入，-1=卖出，0=持有n,
    df['signal'] = 0n,
    df.loc[df['SMA5']  df['SMA20'], 'signal'] = 1n,
    df.loc[df['SMA5']  df['SMA20'], 'signal'] = -1n,
    n,
    # 找出买卖点（信号变化的位置）n,
    df['position'] = df['signal'].diff()n,
    buy_signals = df[df['position'] == 2]   # 从-1变成1，即上穿n,
    sell_signals = df[df['position'] == -2]  # 从1变成-1，即下穿n,
    n,
    print(数据获取成功，共, len(df), 条)n,
    print(买入信号数, len(buy_signals))n,
    print(卖出信号数, len(sell_signals))n,
    print(df[['trade_date', 'close', 'SMA5', 'SMA20', 'signal']].head(10))n,
    n,
    import matplotlib.pyplot as pltn,
    # 解决中文乱码配置（加在这里）n,
    plt.rcParams['font.sans-serif'] = ['Microsoft YaHei', 'SimHei', 'KaiTi']n,
    plt.rcParams['axes.unicode_minus'] = Falsen,
    # 计算策略收益率n,
    df['returns'] = df['close'].pct_change()  # 每日涨跌幅n,
    df['strategy_returns'] = df['signal'].shift(1)  df['returns']  # 次日按信号交易n,
    n,
    # 累计收益n,
    df['cumulative_strategy'] = (1 + df['strategy_returns']).cumprod()n,
    df['cumulative_buyhold'] = (1 + df['returns']).cumprod()n,
    n,
    # 打印收益率n,
    strategy_return = (df['cumulative_strategy'].iloc[-1] - 1)  100n,
    buyhold_return = (df['cumulative_buyhold'].iloc[-1] - 1)  100n,
    print(f策略总收益率 {strategy_return.2f}%)n,
    print(f买入持有收益率 {buyhold_return.2f}%)n,
    n,
    # 画图n,
    plt.figure(figsize=(14, 10))n,
    n,
    # 子图1：价格与买卖点n,
    plt.subplot(2, 1, 1)n,
    plt.plot(df['trade_date'], df['close'], label='收盘价', alpha=0.7, linewidth=1)n,
    plt.plot(df['trade_date'], df['SMA5'], label='5日均线', linewidth=1)n,
    plt.plot(df['trade_date'], df['SMA20'], label='20日均线', linewidth=1)n,
    plt.scatter(buy_signals['trade_date'], buy_signals['close'], color='red', marker='^', s=80, label='买入信号')n,
    plt.scatter(sell_signals['trade_date'], sell_signals['close'], color='green', marker='v', s=80, label='卖出信号')n,
    plt.legend()n,
    plt.title('贵州茅台 - 双均线策略买卖点')n,
    plt.xticks(rotation=45)n,
    n,
    # 子图2：收益曲线对比n,
    plt.subplot(2, 1, 2)n,
    plt.plot(df['trade_date'], df['cumulative_strategy'], label='策略收益', color='blue', linewidth=1.5)n,
    plt.plot(df['trade_date'], df['cumulative_buyhold'], label='买入持有', color='gray', linestyle='--', linewidth=1.5)n,
    plt.legend()n,
    plt.title('累计收益对比')n,
    plt.xticks(rotation=45)n,
    n,
    plt.tight_layout()n,
    plt.show()
