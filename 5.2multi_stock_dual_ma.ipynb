import tushare as ts
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# ================== 1. 解决中文显示问题 ==================
# 设置 matplotlib 使用系统支持的中文字体
plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'PingFang SC', 'Arial Unicode MS']
plt.rcParams['axes.unicode_minus'] = False   # 解决负号显示为方块的问题

# ================== 2. 配置参数 ==================
TOKEN = 'token'   # 请替换成你的真实 Tushare token

# 需要对比的股票 (代码: 名称)
STOCKS = {
    '600519.SH': '贵州茅台',
    '000858.SZ': '五粮液',
    '300750.SZ': '宁德时代',
    '000002.SZ': '万科A',
    '601318.SH': '中国平安'
}

START_DATE = '20200101'
END_DATE   = '20260430'
SHORT_WIN = 5
LONG_WIN  = 20

# ================== 3. 初始化 Tushare ==================
ts.set_token(TOKEN)
pro = ts.pro_api()

# ================== 4. 策略回测函数 ==================
def dual_ma_strategy(ts_code, start, end, short, long):
    """
    返回 DataFrame 包含策略累计收益和买入持有累计收益
    """
    df = pro.daily(ts_code=ts_code, start_date=start, end_date=end)
    if df.empty:
        return None
    df = df.sort_values('trade_date').reset_index(drop=True)
    
    # 计算均线
    df['SMA_short'] = df['close'].rolling(short).mean()
    df['SMA_long']  = df['close'].rolling(long).mean()
    
    # 生成信号
    df['signal'] = 0
    df.loc[df['SMA_short'] > df['SMA_long'], 'signal'] = 1
    df.loc[df['SMA_short'] < df['SMA_long'], 'signal'] = -1
    
    # 策略收益
    df['returns'] = df['close'].pct_change()
    df['strategy_returns'] = df['signal'].shift(1) * df['returns']
    df['cumulative_strategy'] = (1 + df['strategy_returns']).fillna(1).cumprod()
    df['cumulative_buyhold'] = (1 + df['returns']).fillna(1).cumprod()
    
    return df

# ================== 5. 回测并收集结果 ==================
results = {}   # {股票名称: {各项指标, 累计收益曲线}}

for ts_code, name in STOCKS.items():
    print(f"正在处理: {name} ({ts_code})")
    df = dual_ma_strategy(ts_code, START_DATE, END_DATE, SHORT_WIN, LONG_WIN)
    if df is None:
        print(f"  警告: {name} 没有获取到数据，已跳过")
        continue
    
    # 计算风险指标
    strat_returns = df['strategy_returns'].dropna()
    if len(strat_returns) == 0:
        print(f"  警告: {name} 策略收益序列为空，跳过")
        continue
    
    # 总收益率
    total_return = df['cumulative_strategy'].iloc[-1] - 1
    # 年化收益率
    years = len(df) / 252
    annual_return = (1 + total_return) ** (1 / years) - 1 if years > 0 else 0
    
    # 夏普比率 (无风险利率 2%)
    risk_free = 0.02
    excess = strat_returns.mean() * 252 - risk_free
    sharpe = excess / (strat_returns.std() * np.sqrt(252)) if strat_returns.std() != 0 else 0
    
    # 最大回撤
    cum = (1 + strat_returns).cumprod()
    rolling_max = cum.expanding().max()
    drawdown = (cum - rolling_max) / rolling_max
    max_drawdown = drawdown.min()
    
    # 胜率
    win_rate = (strat_returns[strat_returns != 0] > 0).mean() if (strat_returns != 0).any() else 0
    
    results[name] = {
        'code': ts_code,
        'total_return': total_return,
        'annual_return': annual_return,
        'sharpe': sharpe,
        'max_drawdown': max_drawdown,
        'win_rate': win_rate,
        'trade_date': df['trade_date'],
        'cumulative_strategy': df['cumulative_strategy'],
        'cumulative_buyhold': df['cumulative_buyhold']
    }
    print(f"  完成: 年化收益 {annual_return:.2%}, 夏普 {sharpe:.2f}")

if len(results) == 0:
    print("没有成功回测任何股票，请检查网络或 Tushare token。")
else:
    # ================== 6. 打印中文汇总表格 ==================
    print("\n" + "="*70)
    print("策略绩效汇总 (5日/20日双均线)")
    print("="*70)
    summary_df = pd.DataFrame([{
        '股票': name,
        '年化收益': f"{d['annual_return']:.2%}",
        '夏普比率': f"{d['sharpe']:.2f}",
        '最大回撤': f"{d['max_drawdown']:.2%}",
        '胜率': f"{d['win_rate']:.2%}"
    } for name, d in results.items()])
    print(summary_df.to_string(index=False))
    
    # ================== 7. 绘制收益曲线对比图 (中文标题) ==================
    plt.figure(figsize=(14, 8))
    for name, d in results.items():
        plt.plot(d['trade_date'], d['cumulative_strategy'], label=f"{name} (策略)", lw=1.5)
    plt.title('多股票双均线策略累计收益对比', fontsize=14)
    plt.xlabel('日期')
    plt.ylabel('累计净值')
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig('multi_stock_curve.png')
    plt.show()
    
    # ================== 8. 单独绘制每只股票的策略 vs 买入持有 ==================
    n = len(results)
    fig, axes = plt.subplots(n, 1, figsize=(12, 4*n))
    if n == 1:
        axes = [axes]
    for idx, (name, d) in enumerate(results.items()):
        ax = axes[idx]
        ax.plot(d['trade_date'], d['cumulative_strategy'], label='策略', color='blue')
        ax.plot(d['trade_date'], d['cumulative_buyhold'], label='买入持有', color='gray', linestyle='--')
        ax.set_title(f"{name} - 收益对比", fontsize=12)
        ax.legend()
        ax.grid(True, alpha=0.3)
        ax.set_ylabel('累计净值')
    plt.tight_layout()
    plt.savefig('multi_stock_individual.png')
    plt.show()
    
    print("\n对比图已保存: multi_stock_curve.png 和 multi_stock_individual.png")